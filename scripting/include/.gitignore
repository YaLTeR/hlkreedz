// This gitignore is here because it seems faster to do this
// than adapting Destro's Sublime AMXX-Editor v3.0Beta to read multiple include directories
// Note: this gitignore is not a good idea.  One can easily miss adding an include to the whitelist

// Ignore every include
*.inc

// Whitelist our custom includes
!amx_settings_api.inc
!curl.inc
!curl_consts.inc
!ham_const.inc
!hamsandwich.inc
!hl.inc
!hlkz.inc
!mysqlt.inc
!q.inc
!q_cookies.inc
!q_jumpstats.inc
!q_jumpstats_const.inc
!q_menu.inc
!q_menu_const.inc
!q_message.inc
